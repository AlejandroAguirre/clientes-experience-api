<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:apikit="http://www.mulesoft.org/schema/mule/mule-apikit" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns:http="http://www.mulesoft.org/schema/mule/http" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd http://www.mulesoft.org/schema/mule/mule-apikit http://www.mulesoft.org/schema/mule/mule-apikit/current/mule-apikit.xsd http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd ">
    <http:listener-config name="clientes-experience-api-httpListenerConfig">
        <http:listener-connection host="0.0.0.0" port="8084" />
    </http:listener-config>
    <apikit:config name="clientes-experience-api-config" api="clientes-experience-api.raml" outboundHeadersMapName="outboundHeaders" httpStatusVarName="httpStatus" />
    <http:request-config name="HTTP_Request_configuration" doc:name="HTTP Request configuration" doc:id="759a78d9-0458-4778-9371-e00d50ff1af2" basePath="/api/process" >
        <http:request-connection host="localhost" port="8082" />
    </http:request-config>
    <flow name="clientes-experience-api-main">
        <http:listener config-ref="clientes-experience-api-httpListenerConfig" path="/api/experience/*">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers>
                    <![CDATA[#[vars.outboundHeaders default {}]]]>
                
                </http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body>
                    <![CDATA[#[payload]]]>
                
                </http:body>
                <http:headers>
                    <![CDATA[#[vars.outboundHeaders default {}]]]>
                
                </http:headers>
            </http:error-response>
        </http:listener>
        <apikit:router config-ref="clientes-experience-api-config" />
        <error-handler>
            <!-- 400 -->
            <on-error-propagate type="APIKIT:BAD_REQUEST">
                <ee:transform>
                    <ee:message>
                        <ee:set-payload>
                            <![CDATA[
%dw 2.0
output application/json
---
{
    code: "BAD_REQUEST",
    message: "La solicitud es inválida."
}
                ]]>
                        
                        </ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">
                            <![CDATA[400]]>
                        
                        </ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <!-- 404 -->
            <on-error-propagate type="APIKIT:NOT_FOUND">
                <ee:transform>
                    <ee:message>
                        <ee:set-payload>
                            <![CDATA[
%dw 2.0
output application/json
---
{
    code: "NOT_FOUND",
    message: "Recurso no encontrado."
}
                ]]>
                        
                        </ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">
                            <![CDATA[404]]>
                        
                        </ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <!-- 405 -->
            <on-error-propagate type="APIKIT:METHOD_NOT_ALLOWED">
                <ee:transform>
                    <ee:message>
                        <ee:set-payload>
                            <![CDATA[
%dw 2.0
output application/json
---
{
    code: "METHOD_NOT_ALLOWED",
    message: "Método no permitido."
}
                ]]>
                        
                        </ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">
                            <![CDATA[405]]>
                        
                        </ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <!-- Error 400 proveniente de la Process API -->
            <on-error-propagate type="HTTP:BAD_REQUEST">
                <set-payload value="#[error.errorMessage.payload]"/>
                <set-variable variableName="httpStatus" value="400"/>
            </on-error-propagate>
            <!-- Error de conexión con Process API -->
            <on-error-propagate type="HTTP:CONNECTIVITY" logException="true">
                <logger level="ERROR"
                message='Error de conectividad: #[error.description]' />
                <ee:transform>
                    <ee:message>
                        <ee:set-payload>
                            <![CDATA[
%dw 2.0
output application/json
---
{
    code: "SERVICE_UNAVAILABLE",
    message: "No fue posible comunicarse con el servicio de clientes."
}
                ]]>
                        
                        </ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">
                            <![CDATA[503]]>
                        
                        </ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <!-- Timeout -->
            <on-error-propagate type="HTTP:TIMEOUT" logException="true">
                <ee:transform>
                    <ee:message>
                        <ee:set-payload>
                            <![CDATA[
%dw 2.0
output application/json
---
{
    code: "TIMEOUT",
    message: "El servicio tardó demasiado en responder."
}
                ]]>
                        
                        </ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">
                            <![CDATA[504]]>
                        
                        </ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <!-- el que viene de mi servicio legado -->
            <on-error-propagate type="HTTP:NOT_FOUND">
                <set-payload value="#[error.errorMessage.payload]" />
                <set-variable variableName="httpStatus" value="404"/>
            </on-error-propagate>
            <!-- Cualquier otro error -->
            <on-error-propagate type="ANY" logException="true">
                <logger level="ERROR"
            message='Tipo: #[error.errorType]
Descripción: #[error.description]
Payload Error: #[error.errorMessage.payload default "Sin payload"]'/>
                <ee:transform>
                    <ee:message>
                        <ee:set-payload>
                            <![CDATA[
%dw 2.0
output application/json
---
{
    code: "INTERNAL_SERVER_ERROR",
    message: "Ocurrió un error interno."
}
            ]]>
                        
                        </ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">500</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
        </error-handler>
    </flow>
    <flow name="clientes-experience-api-console">
        <http:listener config-ref="clientes-experience-api-httpListenerConfig" path="/console/*">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body>#[payload]</http:body>
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:error-response>
        </http:listener>
        <apikit:console config-ref="clientes-experience-api-config" />
        <error-handler>
            <on-error-propagate type="APIKIT:NOT_FOUND">
                <ee:transform doc:name="Transform Message">
                    <ee:message>
                        <ee:set-payload>
                            <![CDATA[%dw 2.0
output application/json
---
{message: "Resource not found"}]]>
                        
                        </ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">404</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
        </error-handler>
    </flow>
    <flow name="get:\clientes:clientes-experience-api-config">
        <logger level="INFO" doc:name="Logger" message="Consultando todos los clientes"/>
        <http:request 
        method="GET"
        doc:name="Request"
        doc:id="f3513022-600e-41a4-b0d4-a1c6c22551e2"
        config-ref="HTTP_Request_configuration"
        path="/clientes"/>
    </flow>
    <flow name="put:\clientes\(id):application\json:clientes-experience-api-config">
        <http:request
        method="PUT"
        config-ref="HTTP_Request_configuration"
        path="/clientes/{id}">
            <http:body>
                <![CDATA[#[payload]]]>
            </http:body>
            <http:uri-params>
                <![CDATA[#[{
            id: attributes.uriParams.id
        }]]]>
            </http:uri-params>
        </http:request>
    </flow>
    <flow name="delete:\clientes\(id):clientes-experience-api-config">
        <http:request method="DELETE" doc:name="Request" doc:id="afe9c245-3b98-49f6-aa09-f6f61ccd1df7" config-ref="HTTP_Request_configuration" path="/clientes/{id}">
            <http:uri-params>
#[{
    id: attributes.uriParams.id
}]
</http:uri-params>
        </http:request>
    </flow>
    <flow name="get:\clientes\(id):clientes-experience-api-config">
        <logger level="INFO" doc:name="Logger" doc:id="fd96fcb6-a82b-4cfb-b099-15be5bc7cf4b" />
        <http:request 
        method="GET" 
        doc:name="Request" 
        doc:id="c777c6f9-b501-492d-adf2-33be0ed765c8"
        config-ref="HTTP_Request_configuration" 
        path="/clientes/{id}">
            <http:uri-params>
                <![CDATA[#[{
            id: attributes.uriParams.id
        }]]]>
            </http:uri-params>
        </http:request>
    </flow>
    <flow name="post:\clientes:application\json:clientes-experience-api-config">
        <http:request
        method="POST"
        config-ref="HTTP_Request_configuration"
        path="/clientes">
            <http:body>
                <![CDATA[#[payload]]]>
            </http:body>
            <http:response-validator>
                <http:success-status-code-validator values="200..499"/>
            </http:response-validator>
        </http:request>
        <logger 
        level="INFO"
        message="#['Status Process API: ' ++ attributes.statusCode]"/>
    </flow>
</mule>
